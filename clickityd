const APP_DIR = Path(__file__).parent

fn sounds-dir() -> Path {
    let installed = APP_DIR.parent / 'share' / 'clickity' / 'sounds'
    installed.exists? ? installed : (APP_DIR / 'sounds')
}

fn config-path() -> Path {
    let installed = APP_DIR.parent / 'share' / 'clickity' / 'config.json'
    let user      = Path.home() / '.config' / 'clickity' / 'config.json'
    installed.exists? ? installed : user
}

fn load-config() -> Config {
    let path = config-path()

    if path.exists? {
        try {
            return json.parse(Config, path.read-text())
        } catch err {
            warn!("failed to load config: {err}")
        }
    }

    return {
        profile:   nil,
        volume:    0.4,
        active:    true,
        blacklist: []
    }
}

fn store-config(conf: Config) {
    let path = config-path()

    try {
        path.parent.mkdir(parents=true, exist-ok=true)
        path.write(json.encode(conf))
    } catch err {
        warn!("failed to store config: {err}")
    }
}

fn mono-to-stereo(src: ClickSound) -> ClickSound {
    let stereo = src.len * 2
    let ptr    = c.new(c.float, stereo)
    let one    = static!(c.box(c.float, 1.0))

    np.raw.vDSP_vsmul(src.ptr, 1, one, ptr,     2, src.len)
    np.raw.vDSP_vsmul(src.ptr, 1, one, ptr + 1, 2, src.len)

    ClickSound(ptr=ptr, len=stereo)
}

fn prepare-click(mono: ClickSound, vol: Float, pitch: Float) -> Ptr[_] {
    let out-len = int(mono.len / pitch)
    let buf     = c.new(c.float, out-len)
    let idx     = c.new(c.float, out-len)

    for i in ..out-len {
        idx[i] = i * pitch
    }

    np.raw.vDSP_vlint(mono.ptr, idx, 1, buf, 1, out-len, mono.len)
    c.free(idx)

    let stereo-len = out-len * 2
    let ptr        = c.new(c.float, stereo-len)
    let sp         = static!(c.box(c.float))

    sp[0] = vol
    np.raw.vDSP_vsmul(buf, 1, sp, ptr,     2, out-len)
    np.raw.vDSP_vsmul(buf, 1, sp, ptr + 1, 2, out-len)
    c.free(buf)

    c.pack('qi', ptr, stereo-len)
}

fn load-profile(
    dir: Path
) -> (
    Dict[Int, ClickSound],
    Dict[Int, ClickSound],
    Array[ClickSound],
    Array[ClickSound]
) {
    let cfg: _ = json.parse((dir / 'config.json').read-text())

    let all-pcm = vorbis.read-mono(dir / 'sound.ogg')

    let downs = %{}
    let ups   = %{}
    let all-d = []
    let all-u = []

    for name, def in cfg['definitions'] {
        let $mac-key = WEB_KEY_TO_MAC[name] or continue
        let timing: _ = def['timing']

        let ds = int(timing[0][0] * SAMPLE_RATE / 1000.0)
        let de = int(timing[0][1] * SAMPLE_RATE / 1000.0)
        let us = int(timing[1][0] * SAMPLE_RATE / 1000.0)
        let ue = int(timing[1][1] * SAMPLE_RATE / 1000.0)

        fn slice(src: vorbis.OggAudio, from: Int, to: Int) -> ClickSound {
            let len = to - from
            let ptr = src.ptr.as(c.float)
            let new = c.new(c.float, len, ptr + from)
            ClickSound(ptr=new, len=len)
        }

        let d = slice(all-pcm, ds, de)
        let u = slice(all-pcm, us, ue)

        downs[mac-key] = d
        ups[mac-key]   = u
        all-d.push(d)
        all-u.push(u)
    }

    (downs, ups, all-d, all-u)
}

fn profile-names() -> Array[String] {
    [p.name for p in sounds-dir().ls() if p.dir?]
}

let SOCK_DIR  = Path.home() / 'Library' / 'Application Support' / 'clickity'
let SOCK_PATH = SOCK_DIR / 'clickity.sock'

let voice-queue: SharedQueue[Ptr[_]] = SharedQueue()

let _snd = ClickSound()

fn main() {
    if !accessibility-trusted?() {
        os.sleep(3.0)
        exit(1)
    }

    let profiles = profile-names()
    let config   = load-config()

    let profile = if let $name = config.profile and name in profiles {
        name
    } else {
        warn!("using a random profile")
        rand(profiles)
    }

    info!("profile: {profile}")

    let sounds = sounds-dir() / profile
    let (downs, ups, all-downs, all-ups) = load-profile(sounds)

    let active? = config.active
    let volume  = config.volume

    info!("loaded {#all-downs} down + {#all-ups} up clicks (mono, pitch-shifted per keystroke)")

    let lo = c.box(c.float, -1.0)
    let hi = c.box(c.float,  1.0)

    let render = fn (buf: Ptr[_], frames: Int, channels: Int) {
        let vptrs: Array[Ptr] = static!([])
        let vlens: Array[Int] = static!([])
        let voffs: Array[Int] = static!([])
        let n-samp = frames * channels

        while let Some(p-snd) = voice-queue.try-take() {
            let ptr = c.load(c.ptr, p-snd).as(c.float)
            let len = c.load(c.int, p-snd.as(c.u8) + 8)
            c.free(p-snd)
            vptrs.push(ptr)
            vlens.push(len)
            voffs.push(0)
        }

        np.raw.vDSP_vclr(buf, 1, n-samp)

        let j = 0
        while j < #vptrs {
            let remaining = vlens[j] - voffs[j]
            let consume   = min(n-samp, remaining)

            np.raw.vDSP_vadd(buf, 1, vptrs[j] + voffs[j], 1, buf, 1, consume)

            if (voffs[j] += consume) == vlens[j] {
                c.free(vptrs.pop(j))
                vlens.pop(j)
                voffs.pop(j)
            } else {
                j++
            }
        }

        np.raw.vDSP_vclip(buf, 1, lo, hi, buf, 1, n-samp)
    }

    fn make-output() -> AudioOutput {
        let fmt = audio.pcm-format(
            sample-rate=SAMPLE_RATE as Float,
            channels=2,
            bits=32
        )
        let hw = audio.device-buffer-frame-size()
        info!("audio: AudioUnit ({SAMPLE_RATE}Hz, float32, stereo, {hw} frames/callback)")
        let au = AudioOutput(format=fmt, render=render)
        au.start!()
        au
    }

    let ^au = make-output()

    let device-change-queue = SharedQueue()
    let ^device-listener = audio.DeviceListener(queue=device-change-queue)

    let prev-flags = 0

    fn trigger(keycode: Int, down?: Bool) {
        if !active? {
            return
        }
        let pool     = down? ? downs     : ups
        let fallback = down? ? all-downs : all-ups
        let src      = pool[keycode] ?? rand(fallback)
        let vol      = volume * (0.8 + rand() * 0.2)
        let pitch    = 0.9 + rand() * 0.2
        voice-queue.put(prepare-click(src, vol, pitch))
    }

    let blacklist = config.blacklist

    let block?   = false
    let last-pid = -1

    fn on-key(ev-type: Int, ev: CGEvent) {
        let pid = ev.get-int(cg.kEventTargetUnixProcessID)

        if pid != last-pid {
            let name = window-name(pid)
            block?   = blacklist.any?(\_ in name)
            last-pid = pid
        }

        if block? {
            return ev
        }

        let keycode = ev.get-int(cg.kKeyboardEventKeycode)

        if ev-type == cg.kEventKeyDown {
            if ev.get-int(cg.kKeyboardEventAutorepeat) == 0 {
                trigger(keycode, true)
            }
        } else if ev-type == cg.kEventKeyUp {
            trigger(keycode, false)
        } else if ev-type == cg.kEventFlagsChanged {
            let flags  = ev.flags
            let down?  = (flags & ~prev-flags) != 0
            prev-flags = flags
            trigger(keycode, down?)
        }

        ev
    }

    let mask = (1 << cg.kEventKeyDown)
             | (1 << cg.kEventKeyUp)
             | (1 << cg.kEventFlagsChanged)

    let ^tap = EventTap(mask, on-key, options=cg.kEventTapOptionListenOnly)

    fn save-config() {
        let conf: Config = {profile, volume, active: active?, blacklist}
        store-config(conf)
        info!("updated config: {conf}")
    }

    fn handle-cmd(req: _) {
        match req['cmd'] {
            'on' => {
                active? = true
                tap.enable!()
                return {ok: true}
            },
            'off' => {
                active? = false
                tap.disable!()
                return {ok: true}
            },
            'switch' => {
                if not let $name = req['profile'] {
                    return {ok: false, error: 'missing profile'}
                }
                if name == 'random' {
                    name = rand(profiles)
                }
                let sounds = (sounds-dir() / name)
                if !sounds.exists? {
                    return {ok: false, error: "unknown profile: {name}"}
                }
                try {
                    let (d, u, ad, au) = load-profile(sounds)
                    downs       = d
                    ups         = u
                    all-downs   = ad
                    all-ups     = au
                    profile     = name
                    info!("switched to profile: {name}")
                    return {ok: true, profile: name}
                } catch err {
                    return {ok: false, error: "failed to load profile: {err}"}
                }
            },
            'volume' => {
                if not let lvl: Int | Float = req['level'] {
                    return {ok: false, error: 'missing level'}
                }
                if lvl < 0.0 || lvl > 100.0 {
                    return {ok: false, error: 'level must be 0-100'}
                }
                volume = lvl / 100.0
                info!("volume: {lvl}%")
                return {ok: true, volume: lvl}
            },
            'blacklist' => {
                if not let what: String = req['what'] {
                    return {ok: false, error: 'missing name pattern'}
                }

                let added   = nil
                let removed = nil

                if !req['delete'] {
                    if what not in blacklist {
                        blacklist.push(what)
                        added = what
                        info!("added to blacklist: {what}")
                    }
                } else {
                    if let $i = blacklist.search(what) {
                        blacklist.pop(i)
                        removed = what
                        info!("removed from blacklist: {what}")
                    }
                }

                return {ok: true, added, removed}
            },
            'status' => {
                return {
                    ok: true,
                    active: active?,
                    profile,
                    volume: int(volume * 100),
                    blacklist
                }
            },
            'list' => {
                return {
                    ok: true,
                    profiles
                }
            },
            _ => {
                return {
                    ok: false,
                    error: 'unknown command'
                }
            }
        }
    }

    let cmd-queue = SharedQueue()

    fn serve-socket() {
        SOCK_DIR.mkdir(parents=true, exist-ok=true)

        if SOCK_PATH.exists? {
            SOCK_PATH.unlink()
        }

        let server = listen('unix', str(SOCK_PATH))
        info!("socket: {SOCK_PATH}")

        for (;;) {
            let (fd, _) = accept(server)
            let data = read(fd, 4096)
            let req = json.parse(data.str!())
            let reply = SharedQueue()
            cmd-queue.put({req, reply})
            let response = reply.take()
            write(fd, "{json.encode(response)}\n", all=true)
            close(fd)
        }
    }

    let server = Thread(serve-socket)
    let stop?  = false

    signal(SIGINT,  () -> (stop? = true))
    signal(SIGTERM, () -> (stop? = true))
    signal(SIGPIPE, () -> do {})

    info!('listening for keystrokes')

    while !stop? {
        while let Some({req, reply}) = cmd-queue.try-take() {
            reply.put(handle-cmd(req))
            save-config()
        }
        if let Some(_) = device-change-queue.try-take() {
            device-change-queue.clear()
            info!("audio device changed, rebuilding output")
            au.close()
            au = make-output()
        }
        run-loop.run(0.125)
    }

    if SOCK_PATH.exists? {
        SOCK_PATH.unlink()
    }

    info!('shutdown')
}

main()
