let PI = 3.14159265358979323846

fn ilog(n: Int) -> Int {
    let r = 0
    let v = n
    while v > 0 {
        r += 1
        v >>= 1
    }
    r
}

fn lookup1-values(entries: Int, dims: Int) -> Int {
    let r = int(pow(float(entries), 1.0 / dims))
    while int(pow(float(r + 1), float(dims))) <= entries { r += 1 }
    r
}

fn float32-unpack(x: Int) -> Float {
    let mantissa = x & 0x1fffff
    let sign     = x & 0x80000000
    let exponent = (x & 0x7fe00000) >> 21
    let m = (sign != 0) ? -float(mantissa) : float(mantissa)
    m * pow(2.0, float(exponent) - 788.0)
}

class BitReader {
    data: Blob
    pos: Int

    init(d: Blob) {
        data = d
        pos = 0
    }

    read(n: Int) -> Int {
        if n <= 0 { return 0 }
        let val = 0
        for i in ..n {
            let byte-idx = (pos + i) >> 3
            let bit-idx  = (pos + i) & 7
            if byte-idx < #data && (data[byte-idx] >> bit-idx) & 1 != 0 {
                val |= (1 << i)
            }
        }
        pos += n
        val
    }

    read-flag() -> Bool {
        read(1) != 0
    }

    done? -> Bool {
        pos >> 3 >= #data
    }

    byte-align() {
        pos = (pos + 7) & ~7
    }
}

class Codebook {
    dimensions:  Int
    entries:     Int
    lengths:     Array[Int]
    multiplicands: Array[Int]
    lookup-type: Int
    min-value:   Float
    delta-value: Float
    sequence-p:  Bool
    value-bits:  Int
    lookup-values: Int

    sorted-entries: Array[Int]
    sorted-codewords: Array[Int]

    init(br: BitReader) {
        let sync = br.read(24)
        if sync != 0x564342 { throw RuntimeError("bad codebook sync: {sync}") }

        dimensions = br.read(16)
        entries    = br.read(24)

        lengths = [-1 for ..entries]

        let ordered = br.read-flag()
        if ordered {
            let cur-length = br.read(5) + 1
            let i = 0
            while i < entries {
                let num = br.read(ilog(entries - i))
                for j in ..num {
                    if i + j < entries { lengths[i + j] = cur-length }
                }
                i += num
                cur-length += 1
            }
        } else {
            let sparse = br.read-flag()
            for i in ..entries {
                if sparse {
                    if br.read-flag() {
                        lengths[i] = br.read(5) + 1
                    }
                } else {
                    lengths[i] = br.read(5) + 1
                }
            }
        }

        build-huffman()

        lookup-type = br.read(4)
        multiplicands = []
        min-value = 0.0
        delta-value = 0.0
        sequence-p = false
        value-bits = 0
        lookup-values = 0

        if lookup-type == 1 || lookup-type == 2 {
            min-value   = float32-unpack(br.read(32))
            delta-value = float32-unpack(br.read(32))
            value-bits  = br.read(4) + 1
            sequence-p  = br.read-flag()

            lookup-values = if lookup-type == 1 {
                lookup1-values(entries, dimensions)
            } else {
                entries * dimensions
            }

            multiplicands = [br.read(value-bits) for ..lookup-values]
        }
    }

    build-huffman() {
        sorted-entries = []
        sorted-codewords = []

        let max-len = 0
        for i in ..entries {
            if lengths[i] > max-len { max-len = lengths[i] }
        }

        let next-code = [0 for ..(max-len + 2)]
        let bl-count = [0 for ..(max-len + 2)]

        for i in ..entries {
            if lengths[i] > 0 { bl-count[lengths[i]] += 1 }
        }

        let code = 0
        for bits in 1..(max-len + 1) {
            code = (code + bl-count[bits - 1]) << 1
            next-code[bits] = code
        }

        for i in ..entries {
            let len = lengths[i]
            if len <= 0 { continue }

            let cw = next-code[len]
            next-code[len] += 1

            let rev = 0
            for b in ..len {
                rev = (rev << 1) | ((cw >> (len - 1 - b)) & 1)
            }

            sorted-entries.push(i)
            sorted-codewords.push(rev)
        }
    }

    fast-table:  Array[Int] = []
    fast-bits:   Int = 10

    build-fast-table() {
        fast-bits = 10
        let table-size = 1 << fast-bits
        fast-table = [-1 for ..table-size]

        for i in ..#sorted-entries {
            let entry = sorted-entries[i]
            let len = lengths[entry]
            if len <= 0 || len > fast-bits { continue }
            let cw = sorted-codewords[i]
            let fill = 1 << len
            let j = cw
            while j < table-size {
                fast-table[j] = i
                j += fill
            }
        }
    }

    decode(br: BitReader) -> Int {
        if #fast-table == 0 { build-fast-table() }

        let peek-val = 0
        for i in ..fast-bits {
            let byte-idx = (br.pos + i) >> 3
            let bit-idx  = (br.pos + i) & 7
            if byte-idx < #br.data && (br.data[byte-idx] >> bit-idx) & 1 != 0 {
                peek-val |= (1 << i)
            }
        }

        let masked = peek-val & ((1 << fast-bits) - 1)
        if fast-table[masked] >= 0 {
            let idx = fast-table[masked]
            let entry = sorted-entries[idx]
            br.pos += lengths[entry]
            return entry
        }

        let bits = 0
        let code = 0
        for len in 1..33 {
            code |= (br.read(1) << bits)
            bits += 1
            for i in ..#sorted-entries {
                if lengths[sorted-entries[i]] == len && sorted-codewords[i] == code {
                    return sorted-entries[i]
                }
            }
        }

        0
    }

    decode-vector(br: BitReader) -> Array[Float] {
        let entry = decode(br)

        if lookup-type == 1 {
            let result = [0.0 for ..dimensions]
            let last = 0.0
            let index-divisor = 1

            for i in ..dimensions {
                let offset = (entry / index-divisor) % lookup-values
                result[i] = float(multiplicands[offset]) * delta-value + min-value + last
                if sequence-p { last = result[i] }
                index-divisor *= lookup-values
            }

            result
        } else if lookup-type == 2 {
            let result = [0.0 for ..dimensions]
            let last = 0.0
            let base = entry * dimensions

            for i in ..dimensions {
                result[i] = float(multiplicands[base + i]) * delta-value + min-value + last
                if sequence-p { last = result[i] }
            }

            result
        } else {
            [0.0 for ..dimensions]
        }
    }
}

class Floor1 {
    partitions:     Int
    partition-classes: Array[Int]
    class-dims:     Array[Int]
    class-subs:     Array[Int]
    class-books:    Array[Int]
    class-subbooks: Array[Array[Int]]
    multiplier:     Int
    x-list:         Array[Int]
    sorted-order:   Array[Int]
    neighbors:      Array[(Int, Int)]

    init(br: BitReader) {
        partitions = br.read(5)
        partition-classes = [br.read(4) for ..partitions]

        let max-class = -1
        for c in partition-classes {
            if c > max-class { max-class = c }
        }

        class-dims    = [0 for ..(max-class + 1)]
        class-subs    = [0 for ..(max-class + 1)]
        class-books   = [0 for ..(max-class + 1)]
        class-subbooks = [[] for ..(max-class + 1)]

        for i in ..(max-class + 1) {
            class-dims[i]  = br.read(3) + 1
            class-subs[i]  = br.read(2)
            if class-subs[i] != 0 {
                class-books[i] = br.read(8)
            }
            let nsub = 1 << class-subs[i]
            class-subbooks[i] = [br.read(8) - 1 for ..nsub]
        }

        multiplier = br.read(2) + 1
        let range-bits = br.read(4)

        x-list = [0, 1 << range-bits]

        for i in ..partitions {
            let cls = partition-classes[i]
            for _j in ..class-dims[cls] {
                x-list.push(br.read(range-bits))
            }
        }

        sorted-order = [*..#x-list].sort(by=\x-list[_])

        neighbors = [(0, 0) for ..#x-list]
        for i in 2..#x-list {
            let lo = -1
            let hi = 65536
            let lo-idx = 0
            let hi-idx = 0
            for j in ..i {
                let v = x-list[j]
                if v < x-list[i] && v > lo {
                    lo = v
                    lo-idx = j
                }
                if v > x-list[i] && v < hi {
                    hi = v
                    hi-idx = j
                }
            }
            neighbors[i] = (lo-idx, hi-idx)
        }
    }

    decode-floor(br: BitReader, codebooks: Array[Codebook], n: Int) -> Array[Float] | nil {
        if !br.read-flag() { return nil }

        let range = match multiplier {
            1 => 256,
            2 => 128,
            3 => 86,
            4 => 64,
            _ => 256
        }

        let y = [0 for ..#x-list]
        y[0] = br.read(ilog(range - 1))
        y[1] = br.read(ilog(range - 1))

        let offset = 2
        for i in ..partitions {
            let cls = partition-classes[i]
            let cdim = class-dims[cls]
            let cbits = class-subs[cls]
            let csub = (1 << cbits) - 1

            let cval = if cbits > 0 {
                codebooks[class-books[cls]].decode(br)
            } else {
                0
            }

            for j in ..cdim {
                let book = class-subbooks[cls][(cval >> (j * cbits)) & csub]
                if book >= 0 {
                    y[offset + j] = codebooks[book].decode(br)
                }
            }
            offset += cdim
        }

        render-floor(y, n)
    }

    render-floor(y-list: Array[Int], n: Int) -> Array[Float] {
        let final-y = [0 for ..#x-list]
        let step2 = [false for ..#x-list]

        step2[0] = true
        step2[1] = true
        final-y[0] = y-list[0]
        final-y[1] = y-list[1]

        for i in 2..#x-list {
            let (lo-idx, hi-idx) = neighbors[i]
            let predicted = render-point(
                x-list[lo-idx], final-y[lo-idx],
                x-list[hi-idx], final-y[hi-idx],
                x-list[i]
            )
            let val = y-list[i]
            let hi-room = (match multiplier { 1 => 256, 2 => 128, 3 => 86, _ => 64 }) - predicted
            let lo-room = predicted

            let room = if hi-room < lo-room { hi-room * 2 } else { lo-room * 2 }

            if val != 0 {
                step2[lo-idx] = true
                step2[hi-idx] = true
                step2[i] = true
                if val >= room {
                    final-y[i] = if hi-room > lo-room {
                        val - lo-room + predicted
                    } else {
                        predicted - val + hi-room - 1
                    }
                } else if val & 1 != 0 {
                    final-y[i] = predicted - (val + 1) / 2
                } else {
                    final-y[i] = predicted + val / 2
                }
            } else {
                step2[i] = false
                final-y[i] = predicted
            }
        }

        let result = [0.0 for ..n]
        let lx = 0
        let ly = final-y[sorted-order[0]] * multiplier

        for i in 1..#sorted-order {
            let idx = sorted-order[i]
            if !step2[idx] { continue }
            let hx = x-list[idx]
            let hy = final-y[idx] * multiplier
            if hx >= n { hx = n }
            render-line(lx, ly, hx, hy, result)
            lx = hx
            ly = hy
        }

        for i in lx..n {
            result[i] = (lx > 0) ? result[lx - 1] : 0.0
        }

        result
    }
}

fn render-point(x0: Int, y0: Int, x1: Int, y1: Int, x: Int) -> Int {
    let dy = y1 - y0
    let adx = x1 - x0
    let ady = dy.abs
    let err = ady * (x - x0)
    let off = err / adx
    (dy < 0) ? y0 - off : y0 + off
}

fn render-line(x0: Int, y0: Int, x1: Int, y1: Int, v: Array[Float]) {
    let dy = y1 - y0
    let adx = x1 - x0
    let ady = dy.abs
    let base = dy / adx
    let sy = (dy < 0) ? (base - 1) : (base + 1)
    let x = x0
    let y = y0
    let err = 0

    let ady2 = ady - adx.abs * base.abs
    if x < #v { v[x] = inverse-db(y) }

    for x in (x0 + 1)..x1 {
        err += ady2
        if err >= adx {
            err -= adx
            y += sy
        } else {
            y += base
        }
        if x < #v { v[x] = inverse-db(y) }
    }
}

