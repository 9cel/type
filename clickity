#!./bin/ty

import chalk (chalk, hsl-gradient)
import clap (clap!)
import json
import net (dial)
import os (read, write, close, exit)
import path (Path)
import ty

let SOCK_PATH = Path.home() / 'Library' / 'Application Support' / 'clickity' / 'clickity.sock';

macro PROFILES {
    let app-dir    = Path(__file__).parent
    let installed  = app-dir.parent / 'share' / 'clickity' / 'sounds'
    let sounds-dir = installed.exists? ? installed : (app-dir / 'sounds')

    let profiles = [it.name for sounds-dir.ls() if it.dir?]

    ty.Array([ty.ArrayItem(item: ty.String(it)) for profiles])
}

clap! On {}
clap! Off {}

clap! Switch {
    /// Sound profile name
    profile: String, pos: true, required: false, check: PROFILES
}

clap! Volume {
    /// Volume level (0-100)
    level: Int, pos: true
}

clap! Blacklist {
    /// Window name pattern to blacklist
    pattern: String, pos: true

    /// Remove pattern from blacklist instead of adding it
    delete: Bool
}

clap! ListProfiles {}
clap! Status {}

clap! Args {
    cmd on:     On
    cmd off:    Off
    cmd switch: Switch
    cmd vol:    Volume
    cmd list:   ListProfiles
    cmd status: Status
    cmd blacklist: Blacklist
}

fn send(req) -> _ {
    try let fd = dial('unix', "{SOCK_PATH}") else {
        eprint('clickityd is not running. Start it with: brew services start clickity')
        exit(1)
    }
    write(fd, "{json::encode(req)}\n", all=true)
    let data = read(fd, 4096)
    close(fd)
    json::parse!(data.str!())
}

fn main() {
    let (args, _) = Args.parse()

    let req = match args.cmd {
        c: On           => {cmd: 'on'},
        c: Off          => {cmd: 'off'},
        c: Switch       => {cmd: 'switch', profile: c.profile ?? 'random'},
        c: Volume       => {cmd: 'volume', level: c.level},
        c: ListProfiles => {cmd: 'list'},
        c: Status       => {cmd: 'status'},
        c: Blacklist    => {cmd: 'blacklist', delete: c.delete, what: c.pattern},
        _ => do {
            Args.parse(['clickity', '--help'])
            unreachable!
        }
    }

    let resp = send(req)

    match resp {
        {error, *} => {
            print(chalk"[b bright red]error:[/] {error}")
        },

        {profiles, *} => {
            print(chalk"[green]Available profiles:[/]")
            for profiles {
                print(chalk" [yellow]-[/] [blue]{it}[/]")
            }
        },

        {active, profile, volume: (vol: Int | Float), blacklist, *} => {
            let vol-grad  = hsl-gradient((0.0, 0.6, 0.5), (0.3, 1.0, 0.7))
            let vol-color = vol-grad(vol / 100.0)
            print(
                chalk"[yellow]Status:[/]\n"
                     "  [green]active[/]:  [{active ? 'green' : 'red'}]{active}[/]\n"
                     "  [green]profile[/]: [blue]{profile}[/]\n"
                     "  [green]volume[/]:  [{vol-color}]{vol}%[/]"
            )
            if blacklist {
                print(chalk"\n  [yellow]Blacklisted windows:[/]")
                for blacklist {
                    print(chalk"   [red]-[/] [blue]{it}[/]")
                }
            }
        },

        {profile, *} => {
            print(chalk"[green]OK:[/] switched to profile [blue]{profile}[/]")
        },

        {$added, *} => {
            print(chalk"[green]OK:[/] added [blue]{added}[/] to blacklist")
        },

        {$removed, *} => {
            print(chalk"[green]OK:[/] removed [blue]{removed}[/] from blacklist")
        },

        {added, removed, *} => {
            print(chalk"[green]OK:[/] nothing changed")
        }

        _ => {}
    }
}

main()
