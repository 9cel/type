C! fn {
    int proc_name(int pid, void *buf, uint32_t size);
}

fn window-name(pid: Int) -> String {
    let cache = static!(%{})
    let buf   = static!(c.alloc(1024))

    let now = time.now()

    if let (name, when) = cache[pid] {
        if now - when < 60.0 {
            return name
        } else {
            cache[pid] = nil
        }
    }

    let name = match proc_name(pid, buf, 1024) {
        n: n > 0 => c.str(buf, n),
        _        => ''
    }

    cache[pid] = (name, now)

    name
}

