fn inverse-db(i: Int) -> Float {
    if i < 0 { return 0.0 }
    if i >= #FLOOR1_INVERSE_DB_TABLE { return 0.0 }
    FLOOR1_INVERSE_DB_TABLE[i]
}

class Residue {
    residue-type: Int
    begin:   Int
    end:     Int
    part-size: Int
    classifications: Int
    classbook: Int
    cascade: Array[Int]
    books: Array[Array[Int]]

    init(br: BitReader, rtype: Int) {
        residue-type = rtype
        begin  = br.read(24)
        end    = br.read(24)
        part-size = br.read(24) + 1
        classifications = br.read(6) + 1
        classbook = br.read(8)

        cascade = [0 for ..classifications]
        for i in ..classifications {
            let lo = br.read(3)
            let hi = if br.read-flag() { br.read(5) } else { 0 }
            cascade[i] = hi * 8 + lo
        }

        books = [[0 for ..8] for ..classifications]
        for i in ..classifications {
            for j in ..8 {
                if (cascade[i] & (1 << j)) != 0 {
                    books[i][j] = br.read(8)
                } else {
                    books[i][j] = -1
                }
            }
        }
    }
}

class Mapping {
    submaps:     Int
    couplings:   Array[(Int, Int)]
    mux:         Array[Int]
    submap-floor:   Array[Int]
    submap-residue: Array[Int]

    init(br: BitReader, channels: Int) {
        let p0 = br.pos
        let mapping-type = br.read(16)
        submaps = if br.read-flag() { br.read(4) + 1 } else { 1 }

        couplings = []
        if br.read-flag() {
            let n = br.read(8) + 1
            let bits = ilog(channels - 1)
            for ..n {
                let magnitude = br.read(bits)
                let angle = br.read(bits)
                couplings.push((magnitude, angle))
            }
        }

        let reserved = br.read(2)

        mux = if submaps > 1 {
            [br.read(4) for ..channels]
        } else {
            [0 for ..channels]
        }

        submap-floor   = [0 for ..submaps]
        submap-residue = [0 for ..submaps]
        for i in ..submaps {
            br.read(8)
            submap-floor[i]   = br.read(8)
            submap-residue[i] = br.read(8)
        }
    }
}

class Mode {
    block-flag: Bool
    window-type: Int
    transform-type: Int
    mapping: Int

    init(br: BitReader) {
        block-flag = br.read-flag()
        window-type = br.read(16)
        transform-type = br.read(16)
        mapping = br.read(8)
    }
}

class IMDCTContext {
    n:       Int
    n2:      Int
    n4:      Int
    fft:     FFTSetup
    pre-cos: F32Array
    pre-sin: F32Array
    post-cos: F32Array
    post-sin: F32Array

    init(n: Int) {
        self.n = n
        n2 = n / 2
        n4 = n / 4
        fft = FFTSetup(ilog(n4) - 1)

        pre-cos = F32Array(n4)
        pre-sin = F32Array(n4)
        post-cos = F32Array(n4)
        post-sin = F32Array(n4)

        for k in ..n4 {
            let angle = PI / n * (4 * k + 1) * 0.5
            c.store(c.float, pre-cos.data + k, cos(angle))
            c.store(c.float, pre-sin.data + k, sin(angle))
        }

        for k in ..n4 {
            let angle = PI / n * (2 * k + 1 + n2) * 0.5
            c.store(c.float, post-cos.data + k, cos(angle))
            c.store(c.float, post-sin.data + k, sin(angle))
        }
    }

    transform(input: Array[Float]) -> Array[Float] {
        let re = F32Array(n4)
        let im = F32Array(n4)

        for k in ..n4 {
            let a = input[2 * k]
            let b = input[2 * k + 1]
            let pc = c.load(c.float, pre-cos.data + k)
            let ps = c.load(c.float, pre-sin.data + k)
            c.store(c.float, re.data + k,  a * pc + b * ps)
            c.store(c.float, im.data + k, -a * ps + b * pc)
        }

        fft.fft!(re, im, FFT_INVERSE)

        let tmp-re = F32Array(n4)
        let tmp-im = F32Array(n4)

        for k in ..n4 {
            let xr = c.load(c.float, re.data + k)
            let xi = c.load(c.float, im.data + k)
            let tc = c.load(c.float, post-cos.data + k)
            let ts = c.load(c.float, post-sin.data + k)
            c.store(c.float, tmp-re.data + k, (xr * tc + xi * ts) * (2.0 / n4))
            c.store(c.float, tmp-im.data + k, (-xr * ts + xi * tc) * (2.0 / n4))
        }

        let out = [0.0 for ..n]
        for i in ..n4 {
            out[i]            = -c.load(c.float, tmp-im.data + n4 - 1 - i)
            out[i + n4]       =  c.load(c.float, tmp-re.data + i)
            out[i + n2]       = -c.load(c.float, tmp-im.data + i)
            out[i + n2 + n4]  = -c.load(c.float, tmp-re.data + n4 - 1 - i)
        }

        out
    }
}

let imdct-cache = %{}

fn imdct(input: Array[Float], n: Int) -> Array[Float] {
    let ctx = imdct-cache[n] ?? (imdct-cache[n] = IMDCTContext(n))
    ctx.transform(input)
}

fn vorbis-window(n: Int) -> Array[Float] {
    [sin(PI / 2.0 * sin(PI / n * (i + 0.5)) ** 2) for i in ..n]
}

class VorbisDecoder {
    channels:    Int
    sample-rate: Int
    blocksize:   Array[Int]
    codebooks:   Array[Codebook]
    floors:      Array[Floor1]
    residues:    Array[Residue]
    mappings:    Array[Mapping]
    modes:       Array[Mode]
    windows:     Array[Array[Float]]

    init(setup-data: Blob, channels: Int, sample-rate: Int, blocksize: Array[Int]) {
        self.channels = channels
        self.sample-rate = sample-rate
        self.blocksize = blocksize

        let br = BitReader(setup-data)
        br.pos = 56

        let ncb = br.read(8) + 1
        codebooks = [Codebook(br) for ..ncb]

        let n-times = br.read(6) + 1
        for ..n-times { br.read(16) }

        let n-floors = br.read(6) + 1
        floors = []
        for ..n-floors {
            let ftype = br.read(16)
            if ftype != 1 { throw RuntimeError("only floor type 1 supported, got {ftype}") }
            floors.push(Floor1(br))
        }

        let n-residues = br.read(6) + 1
        residues = []
        for ..n-residues {
            let rtype = br.read(16)
            residues.push(Residue(br, rtype))
        }

        let n-mappings = br.read(6) + 1
        mappings = [Mapping(br, channels) for ..n-mappings]

        let n-modes = br.read(6) + 1
        modes = [Mode(br) for ..n-modes]

        windows = [vorbis-window(blocksize[0]), vorbis-window(blocksize[1])]
    }

    decode-packet(data: Blob) -> Array[Array[Float]] | nil {
        let br = BitReader(data)

        if br.read(1) != 0 { return nil }

        let mode-bits = ilog(#modes - 1)
        let mode-num = br.read(mode-bits)
        let mode = modes[mode-num]
        let n    = blocksize[mode.block-flag ? 1 : 0]
        let n2   = n / 2
        let mapping = mappings[mode.mapping]

        if mode.block-flag {
            br.read(1)
            br.read(1)
        }

        let floor-data: Array[Array[Float] | nil] = [nil for ..channels]

        for ch in ..channels {
            let submap = mapping.mux[ch]
            let floor-num = mapping.submap-floor[submap]
            floor-data[ch] = floors[floor-num].decode-floor(br, codebooks, n2)
        }

        let no-residue = [floor-data[ch] == nil for ch in ..channels]

        let residue-out = [[0.0 for ..n2] for ..channels]

        for i in ..mapping.submaps {
            let ch-list = [ch for ch in ..channels if mapping.mux[ch] == i]
            let do-not-decode = [no-residue[ch] for ch in ch-list]
            let res-num = mapping.submap-residue[i]
            let res = residues[res-num]

            decode-residue(br, res, ch-list, do-not-decode, residue-out, n2)
        }

        for (mag, ang) in mapping.couplings {
            for i in ..n2 {
                let m = residue-out[mag][i]
                let a = residue-out[ang][i]
                if m > 0.0 {
                    if a > 0.0 {
                        residue-out[mag][i] = m
                        residue-out[ang][i] = m - a
                    } else {
                        residue-out[ang][i] = m
                        residue-out[mag][i] = m + a
                    }
                } else {
                    if a > 0.0 {
                        residue-out[mag][i] = m
                        residue-out[ang][i] = m + a
                    } else {
                        residue-out[ang][i] = m
                        residue-out[mag][i] = m - a
                    }
                }
            }
        }

        let pcm = [[0.0 for ..n] for ..channels]

        for ch in ..channels {
            if let $floor = floor-data[ch] {
                for i in ..n2 {
                    residue-out[ch][i] *= floor[i]
                }
            }

            pcm[ch] = imdct(residue-out[ch], n)

            let w = windows[mode.block-flag ? 1 : 0]
            for i in ..n {
                pcm[ch][i] *= w[i]
            }
        }

        pcm
    }

    decode-residue(
        br: BitReader,
        res: Residue,
        ch-list: Array[Int],
        do-not-decode: Array[Bool],
        out: Array[Array[Float]],
        n: Int
    ) {
        let actual-size = n
        if res.residue-type == 2 {
            actual-size = n * #ch-list
        }

        let limit-begin = if res.begin < actual-size { res.begin } else { actual-size }
        let limit-end   = if res.end   < actual-size { res.end   } else { actual-size }

        let classwords-per-codeword = codebooks[res.classbook].dimensions
        let n-to-read = limit-end - limit-begin
        let partitions-to-read = (n-to-read) / (res.part-size)

        if n-to-read == 0 { return }

        let decode-ch-count = (res.residue-type == 2) ? 1 : #ch-list
        let classifications-array = [[0 for ..partitions-to-read] for ..decode-ch-count]

        for pass in ..8 {
            let partition-count = 0
            while partition-count < partitions-to-read {
                if pass == 0 {
                    for j in ..decode-ch-count {
                        let skip? = (res.residue-type == 2)
                            ? do-not-decode.all?(&identity)
                            : do-not-decode[j]
                        if !skip? {
                            let temp = codebooks[res.classbook].decode(br)
                            for i in (classwords-per-codeword - 1).downto(0) {
                                if partition-count + i < partitions-to-read {
                                    classifications-array[j][partition-count + i] = temp % res.classifications
                                }
                                temp /= res.classifications
                            }
                        }
                    }
                }

                for i in ..classwords-per-codeword {
                    if partition-count >= partitions-to-read { break }

                    for j in ..decode-ch-count {
                        let skip? = (res.residue-type == 2)
                            ? do-not-decode.all?(&identity)
                            : do-not-decode[j]
                        if !skip? {
                            let vq-class = classifications-array[j][partition-count]
                            let vq-book = res.books[vq-class][pass]
                            if vq-book >= 0 {
                                let offset = limit-begin + partition-count * res.part-size
                                let cb = codebooks[vq-book]

                                if res.residue-type == 2 {
                                    let k = 0
                                    while k < res.part-size {
                                        let vec = cb.decode-vector(br)
                                        for l in ..cb.dimensions {
                                            let actual-idx = offset + k + l
                                            let target-ch = actual-idx % #ch-list
                                            let target-off = (actual-idx) / (#ch-list)
                                            out[ch-list[target-ch]][target-off] += vec[l]
                                        }
                                        k += cb.dimensions
                                    }
                                } else if res.residue-type == 0 {
                                    let step = (res.part-size) / (cb.dimensions)
                                    for k in ..step {
                                        let vec = cb.decode-vector(br)
                                        for l in ..cb.dimensions {
                                            out[ch-list[j]][offset + k + l * step] += vec[l]
                                        }
                                    }
                                } else {
                                    let k = 0
                                    while k < res.part-size {
                                        let vec = cb.decode-vector(br)
                                        for l in ..cb.dimensions {
                                            out[ch-list[j]][offset + k + l] += vec[l]
                                        }
                                        k += cb.dimensions
                                    }
                                }
                            }
                        }
                    }

                    partition-count += 1
                }
            }
        }
    }
}

fn ogg-packets(data: Blob) -> Array[Blob] {
    let packets = []
    let current = Blob()
    let i = 0

    while i < #data - 27 {
        if data[i] != 0x4f || data[i+1] != 0x67 || data[i+2] != 0x67 || data[i+3] != 0x53 {
            i += 1
            continue
        }

        let header-type = data[i + 5]
        let n-segments = data[i + 26]
        let body-start = i + 27 + n-segments

        if (header-type & 1) == 0 && #current > 0 {
            packets.push(current)
            current = Blob()
        }

        let off = body-start
        for s in ..n-segments {
            let seg-len = data[i + 27 + s]
            current.push(data.slice(off, seg-len))
            off += seg-len
            if seg-len < 255 {
                packets.push(current)
                current = Blob()
            }
        }

        i = off
    }

    if #current > 0 { packets.push(current) }

    packets
}

pub fn decode-file(file: Path) -> (Array[Float], Int, Int) {
    let data = file.read-bytes()
    let packets = ogg-packets(data)

    if #packets < 3 {
        throw RuntimeError("not enough OGG packets (got {#packets})")
    }

    let ident = packets[0]
    if #ident < 30 { throw RuntimeError("ident header too short") }

    let channels = ident[11]
    let sample-rate = 0
    for b in ..4 { sample-rate |= ident[12 + b] << (b * 8) }
    let bs-byte = ident[28]
    let bs0 = 1 << (bs-byte & 0xf)
    let bs1 = 1 << (bs-byte >> 4)

    let decoder = VorbisDecoder(packets[2], channels, sample-rate, [bs0, bs1])
    eprint("[vorbis] {#packets} packets, {channels}ch {sample-rate}Hz, {#decoder.codebooks} codebooks, {#decoder.modes} modes")

    let pcm = []
    let prev-window = nil
    let ok-count = 0
    let err-count = 0

    for i in 3..#packets {
        let body = packets[i]
        if #body == 0 { continue }

        catch e {
            err-count += 1
            continue
        }

        let ch-pcm = decoder.decode-packet(body)
        if let $ch-pcm = ch-pcm {
            ok-count += 1
            let n = #ch-pcm[0]
            let n2 = n / 2

            let mono = [0.0 for ..n]
            if channels == 1 {
                for j in ..n { mono[j] = ch-pcm[0][j] }
            } else {
                for j in ..n {
                    let sum = 0.0
                    for ch in ..channels { sum += ch-pcm[ch][j] }
                    mono[j] = sum * (1.0 / channels)
                }
            }

            if let $prev = prev-window {
                let prev-n = #prev
                let prev-n2 = prev-n / 2
                let cur-n2 = n2
                let overlap = (prev-n2 < cur-n2) ? prev-n2 : cur-n2

                for j in ..overlap {
                    mono[j] += prev[prev-n2 + j]
                }

                if prev-n2 > overlap {
                    pcm += prev[prev-n2 ; prev-n2]
                }
                pcm += mono[;overlap]
            }

            prev-window = mono
        }
    }

    if let $prev = prev-window {
        let n2 = #prev / 2
        pcm += prev[n2 ; #prev]
    }

    eprint("[vorbis] decoded {ok-count} packets, {err-count} errors, {#pcm} samples")
    (pcm, channels, sample-rate)
}
