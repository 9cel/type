const APP_DIR = Path(__file__).parent

fn sounds-dir() -> Path {
    let installed = APP_DIR.parent / 'share' / 'clickity' / 'sounds';
    return installed.exists? ? installed : (APP_DIR / 'sounds')
}

fn load-raw-f32(p: Path) -> Array[Float] {
    let blob = p.read-bytes()
    let n = #blob / 4
    let fmt: _ = "{n}f"
    let tup: _ = c.unpack(fmt, blob)
    [tup[i] for i in ..n]
}

fn load-profile-raw(
    dir: Path
) -> (
    Dict[Int, Array[Float]],
    Dict[Int, Array[Float]],
    Array[Array[Float]],
    Array[Array[Float]]
) {
    let cfg: _ = json::parse((dir / 'config.json').read-text())
    let pcm = load-raw-f32(dir / 'sound.raw')

    let downs = %{}
    let ups   = %{}
    let all-d = []
    let all-u = []

    for name, def in cfg['definitions'] {
        let $mac-key = WEB_KEY_TO_MAC[name] or continue
        let timing: _ = def['timing']

        let ds = int(timing[0][0] * SAMPLE_RATE / 1000.0)
        let de = int(timing[0][1] * SAMPLE_RATE / 1000.0)
        let us = int(timing[1][0] * SAMPLE_RATE / 1000.0)
        let ue = int(timing[1][1] * SAMPLE_RATE / 1000.0)

        let d = pcm[ds;de]
        let u = pcm[us;ue]

        downs[mac-key] = d
        ups[mac-key]   = u
        all-d.push(d)
        all-u.push(u)
    }

    (downs, ups, all-d, all-u)
}

fn profile-names() -> Array[String] {
    [p.name for p in sounds-dir().ls() if p.dir?]
}

let SOCK_DIR  = Path.home() / 'Library' / 'Application Support' / 'clickity'
let SOCK_PATH = SOCK_DIR / 'clickity.sock'

let audio-queue = SharedQueue()
let playing: Array[{samples: Array[Float], pos: Int}] = []

fn main() {
    if !accessibility-trusted?() {
        warn!('waiting for Accessibility permission...')
        while !accessibility-trusted?(prompt?=false) {
            os.sleep(5.0)
        }
        info!('Accessibility permission granted')
    }

    let profiles = profile-names()
    let name = rand(profiles)

    info!("profile: {name}")

    let dir = sounds-dir() / name
    let (down-clicks, up-clicks, all-downs, all-ups) = load-profile-raw(dir)
    let current-profile = name
    let active? = true
    let volume = 1.0
    let paused? = true
    let want-pause? = false
    let want-unpause? = false

    info!("loaded {#all-downs} down + {#all-ups} up clicks")

    let cb-areas = c.box(c.ptr)
    let cb-count = c.box(c.int)

    let prev-flags = 0

    fn on-write(stream-ptr: Ptr, frame-min: Int, frame-max: Int) {
        let stream = SoundIoOutStream(stream-ptr)
        let channels = stream.layout.channel_count

        while let Some(samples) = audio-queue.try-take() {
            playing.push({samples, pos: 0})
        }

        let frames-left = frame-max
        while frames-left > 0 {
            cb-count[0] = frames-left

            if soundio_outstream_begin_write(stream-ptr, cb-areas, cb-count) != 0 {
                return
            }

            let count = cb-count[0]
            let areas = cb-areas[0]

            break if count == 0

            for frame in ..count {
                let sample = 0.0

                let i = 0
                while i < #playing {
                    if playing[i].pos < #playing[i].samples {
                        sample += playing[i].samples[playing[i].pos]
                        playing[i].pos += 1
                        i += 1
                    } else {
                        playing.pop(i)
                    }
                }

                for ch in ..channels {
                    write-sample-float32(areas, ch, frame, sample)
                }
            }

            soundio_outstream_end_write(stream-ptr)
            frames-left -= count
        }

        if #playing == 0 && audio-queue.empty?() {
            want-pause? = true
        }

        nil
    }

    fn trigger(keycode: Int, down?: Bool) {
        if !active? {
            return
        }
        let pool     = down? ? down-clicks : up-clicks
        let fallback = down? ? all-downs   : all-ups
        let samples  = pool[keycode] ?? rand(fallback)
        let vol      = volume * (0.8 + rand() * 0.2)
        want-unpause? = true
        audio-queue.put([it * vol for samples])
    }

    fn on-key(ev-type: Int, ev: CGEvent) {
        let keycode = ev.get-int(cg.kKeyboardEventKeycode)
        if ev-type == cg.kEventKeyDown {
            if ev.get-int(cg.kKeyboardEventAutorepeat) == 0 {
                trigger(keycode, true)
            }
        } else if ev-type == cg.kEventKeyUp {
            trigger(keycode, false)
        } else if ev-type == cg.kEventFlagsChanged {
            let flags  = ev.flags
            let down?  = (flags & ~prev-flags) != 0
            prev-flags = flags
            trigger(keycode, down?)
        }
        ev
    }

    let ^ctx = Context()
    ctx.connect()
    ctx.flush-events()

    let ^device = ctx.default-output-device
    info!("output: {device.name}")

    let ^stream = OutStream(device)
    stream.format = SoundIoFormatFloat32NE
    stream.sample-rate = SAMPLE_RATE
    stream.software-latency = 0.01
    stream.set-write-callback(on-write)
    stream.open()
    stream.start()
    stream.pause()

    let mask = (1 << cg.kEventKeyDown) | (1 << cg.kEventKeyUp) | (1 << cg.kEventFlagsChanged)
    let ^tap = EventTap(mask, on-key, options=cg.kEventTapOptionListenOnly)

    fn handle-cmd(req: _) {
        match req['cmd'] {
            'on' => {
                active? = true
                tap.enable!()
                return {ok: true}
            },
            'off' => {
                active? = false
                tap.disable!()
                return {ok: true}
            },
            'switch' => {
                if not let $pname = req['profile'] {
                    return {ok: false, error: 'missing profile'}
                }
                let pdir = (sounds-dir() / pname)
                if !pdir.exists? {
                    return {ok: false, error: "unknown profile: {pname}"}
                }
                let (d, u, ad, au) = load-profile-raw(pdir)
                down-clicks = d
                up-clicks   = u
                all-downs   = ad
                all-ups     = au
                current-profile = pname
                info!("switched to profile: {pname}")
                return {ok: true, profile: pname}
            },
            'volume' => {
                if not let lvl: Int | Float = req['level'] {
                    return {ok: false, error: 'missing level'}
                }
                if lvl < 0.0 || lvl > 100.0 {
                    return {ok: false, error: 'level must be 0-100'}
                }
                volume = lvl / 100.0
                info!("volume: {lvl}%")
                return {ok: true, volume: lvl}
            },
            'status' => { return {ok: true, active: active?, profile: current-profile, volume: int(volume * 100)} },
            'list'   => { return {ok: true, profiles: profile-names()} },
            _        => { return {ok: false, error: 'unknown command'} }
        }
    }

    let cmd-queue = SharedQueue()

    fn serve-socket() {
        SOCK_DIR.mkdir(parents=true, exist-ok=true)

        if SOCK_PATH.exists? {
            SOCK_PATH.unlink()
        }

        let server = listen('unix', str(SOCK_PATH))
        info!("socket: {SOCK_PATH}")

        for (;;) {
            let (fd, _) = accept(server)
            let data = read(fd, 4096)
            let req = json::parse(data.str!())
            let reply = SharedQueue()
            cmd-queue.put({req, reply})
            let response = reply.take()
            write(fd, "{json::encode(response)}\n", all=true)
            close(fd)
        }
    }

    Thread(serve-socket)

    let stop? = false
    signal(SIGINT,  () -> (stop? = true))
    signal(SIGTERM, () -> (stop? = true))
    signal(SIGPIPE, () -> do {})

    info!('listening for keystrokes')
    while !stop? {
        while let Some({req, reply}) = cmd-queue.try-take() {
            reply.put(handle-cmd(req))
        }
        if want-unpause? && paused? {
            stream.unpause()
            paused? = false
            want-unpause? = false
        }
        if want-pause? && !paused? {
            stream.pause()
            paused? = true
            want-pause? = false
        }
        ctx.flush-events()
        run-loop.run(0.25)
    }

    if SOCK_PATH.exists? {
        SOCK_PATH.unlink()
    }
    info!('shutdown')
}

main()
